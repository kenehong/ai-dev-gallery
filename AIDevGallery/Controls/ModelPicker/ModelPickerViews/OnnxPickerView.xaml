<?xml version="1.0" encoding="utf-8" ?>
<local:BaseModelPickerView
    x:Class="AIDevGallery.Controls.ModelPickerViews.OnnxPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:AIDevGallery.Helpers"
    xmlns:local="using:AIDevGallery.Controls.ModelPickerViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIDevGallery.Models"
    xmlns:mpControls="using:AIDevGallery.Controls.ModelPicker"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:utils="using:AIDevGallery.Utils"
    xmlns:vm="using:AIDevGallery.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="ModelView">
            <Grid Padding="24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="CustomModelInfo"
                    Spacing="12">
                    <TextBlock
                        x:Name="CustomModelsTitle"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Custom models" />
                    <TextBlock
                        x:Name="CustomModelsTxt"
                        Text="To use a custom model, convert it to a WindowsML-compatible format using the AI Toolkit conversion tool. Note: Currently, only select models are supported for conversion in AI Toolkit, with additional models coming soon."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="OpenAIToolkitButton"
                            AutomationProperties.Name="Open AI Toolkit's Conversion tool"
                            Click="OpenAIToolkitButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Width="16">
                                    <Image.Source>
                                        <BitmapImage
                                            DecodePixelHeight="16"
                                            DecodePixelWidth="16"
                                            UriSource="ms-appx:///Assets/AITKIcon.png" />
                                    </Image.Source>
                                </Image>
                                <TextBlock Text="Open AI Toolkit's Conversion tool" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ViewDocumentationButton"
                            AutomationProperties.Name="View documentation"
                            Click="ViewDocumentationButton_Click"
                            Content="View documentation" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Models" />
                    <DropDownButton
                        x:Name="AddModelButtons"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Add model"
                        Content="Add model"
                        Visibility="Collapsed">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem
                                    x:Name="AddHFModelButton"
                                    Click="AddHFModelButton_Click"
                                    Icon="{ui:BitmapIcon Source=ms-appx:///Assets/ModelIcons/HuggingFace.svg}"
                                    Text="Search HuggingFace"
                                    Visibility="Collapsed" />
                                <MenuFlyoutItem
                                    x:Name="AddLocalModelButton"
                                    Click="AddLocalModelButton_Click"
                                    Icon="{ui:FontIcon Glyph=&#xE8DA;}"
                                    Text="From disk"
                                    Visibility="Collapsed" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>

                <Grid
                    Grid.Row="2"
                    Padding="12,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Name" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Device" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Size" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="State" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Action" />
                </Grid>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,12"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind utils:XamlHelpers.VisibleWhenEmpty(ModelRows), Mode=OneWay}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="24"
                        Glyph="&#xE711;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="No models available" />
                </StackPanel>

                <ItemsRepeater
                    Grid.Row="4"
                    IsTabStop="False"
                    ItemsSource="{x:Bind ModelRows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:OnnxModelPickerRow">
                            <Border
                                MinHeight="64"
                                Padding="12"
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image
                                            Width="20"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Source="{x:Bind ModelDetails.Icon, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ModelDetails.Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTipService.ToolTip="{x:Bind ModelDetails.Name, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="More options"
                                            Content="{ui:FontIcon Glyph=&#xE712;,
                                                                  FontSize=16}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="More options">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem
                                                        Click="ModelCard_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE8A5;}"
                                                        Tag="{x:Bind ModelDetails}"
                                                        Text="View model card"
                                                        Visibility="{x:Bind helpers:ModelDetailsHelper.ShowWhenDownloadedModel(ModelDetails)}" />
                                                    <MenuFlyoutItem
                                                        Click="ViewLicense_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE82D;}"
                                                        Tag="{x:Bind ModelDetails}"
                                                        Text="View license" />
                                                    <MenuFlyoutSeparator Visibility="{x:Bind helpers:ModelDetailsHelper.ShowWhenDownloadedModel(ModelDetails)}" />
                                                    <MenuFlyoutItem
                                                        Click="CopyModelPath_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE8C8;}"
                                                        Tag="{x:Bind ModelDetails}"
                                                        Text="Copy as path"
                                                        Visibility="{x:Bind IsInstalled}" />
                                                    <MenuFlyoutItem
                                                        Click="OpenModelFolder_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE838;}"
                                                        Tag="{x:Bind ModelDetails}"
                                                        Text="Open containing folder"
                                                        Visibility="{x:Bind IsInstalled}" />
                                                    <MenuFlyoutSeparator Visibility="{x:Bind IsInstalled}" />
                                                    <MenuFlyoutItem
                                                        Click="DeleteModel_Click"
                                                        Icon="{ui:FontIcon Glyph=&#xE74D;}"
                                                        Tag="{x:Bind ModelDetails}"
                                                        Text="Delete"
                                                        Visibility="{x:Bind IsInstalled}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>

                                    <ItemsRepeater
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        ItemsSource="{x:Bind ModelDetails.HardwareAccelerators, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:HardwareAccelerator">
                                                <Button
                                                    AutomationProperties.Name="{x:Bind utils:AppUtils.GetHardwareAcceleratorMoreInfoName((models:HardwareAccelerator))}"
                                                    Content="{x:Bind utils:AppUtils.GetHardwareAcceleratorString((models:HardwareAccelerator))}"
                                                    Style="{StaticResource TertiaryButtonStyle}"
                                                    ToolTipService.ToolTip="More info">
                                                    <Button.Flyout>
                                                        <Flyout ShouldConstrainToRootBounds="False">
                                                            <TextBlock
                                                                MaxWidth="360"
                                                                Text="{x:Bind utils:AppUtils.GetHardwareAcceleratorDescription((models:HardwareAccelerator))}"
                                                                TextWrapping="Wrap" />
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind SizeText, Mode=OneWay}"
                                        TextWrapping="Wrap" />

                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind StateText, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            ToolTipService.ToolTip="{x:Bind VerificationFailureMessage, Mode=OneWay}" />
                                        <ProgressBar
                                            Visibility="{x:Bind IsDownloading, Mode=OneWay}"
                                            Value="{x:Bind Progress, Mode=OneWay}" />
                                    </StackPanel>

                                    <Grid
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Selected"
                                            Visibility="{x:Bind ShowSelected, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.Name="{x:Bind SelectAccessibleName}"
                                            Click="SelectModelButton_Click"
                                            Content="Select"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanSelect, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.Name="{x:Bind DownloadAccessibleName}"
                                            Click="DownloadModelButton_Click"
                                            Content="Download"
                                            IsEnabled="{x:Bind IsDownloadEnabled, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanDownload, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.Name="{x:Bind CancelAccessibleName}"
                                            Click="CancelDownloadButton_Click"
                                            Content="Cancel"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind IsDownloading, Mode=OneWay}" />
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind VerificationFailureMessage, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind RetryAccessibleName}"
                                            Click="RetryDownloadButton_Click"
                                            Content="Retry"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <mpControls:AddHFModelView
            x:Name="AddHFModelView"
            CloseRequested="AddHFModelView_CloseRequested"
            Visibility="Collapsed" />

        <ContentDialog
            x:Name="DownloadDialog"
            Title="Download model"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="{Binding ElementName=AgreeCheckBox, Path=IsChecked}"
            PrimaryButtonText="Download"
            SecondaryButtonText="Cancel">
            <ContentDialog.Content>
                <StackPanel MinWidth="360">
                    <InfoBar
                        x:Name="WarningInfoBar"
                        Margin="0,0,0,16"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning"
                        Title="Model is not recommended" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="You are about to download" />
                        <Run x:Name="ModelNameTxt" FontWeight="SemiBold" />
                        <Run Text="from" />
                        <Run x:Name="ModelSourceTxt" FontWeight="SemiBold" />
                        <LineBreak />
                        <LineBreak />
                        <Run Text="License:" />
                        <Hyperlink x:Name="ModelLicenseLink">
                            <Run x:Name="ModelLicenseLabel" />
                        </Hyperlink>
                    </TextBlock>
                    <CheckBox
                        x:Name="AgreeCheckBox"
                        Margin="0,16,0,0"
                        Content="I have reviewed and agree with the license" />
                </StackPanel>
            </ContentDialog.Content>
        </ContentDialog>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SideCustomModelInfoVisibilityStates">
                <VisualState x:Name="SideCustomModelInfoVisible" />
                <VisualState x:Name="SideCustomModelInfoCollapsed">
                    <VisualState.Setters>
                        <Setter Target="CustomModelInfo.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:BaseModelPickerView>
