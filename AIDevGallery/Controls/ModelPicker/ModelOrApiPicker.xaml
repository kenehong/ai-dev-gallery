<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AIDevGallery.Controls.ModelOrApiPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AIDevGallery.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelpickerviews="using:AIDevGallery.Controls.ModelPickerViews"
    xmlns:models="using:AIDevGallery.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:utils="using:AIDevGallery.Utils"
    Visibility="Collapsed"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ThemeShadow x:Name="DialogShadow" />
        <SolidColorBrush x:Key="AppSmokeBrush" Color="#4D000000" />
    </UserControl.Resources>
	<Grid x:Name="ModelOrApiPickerOverlayRoot" TabFocusNavigation="Cycle">
        <Grid
            x:Name="ShadowGrid"
            Background="{ThemeResource AppSmokeBrush}"
            HighContrastAdjustment="None"
            Loaded="ShadowGrid_Loaded"
            Tapped="ShadowGrid_Tapped" />

        <Grid
            MaxWidth="786"
            MaxHeight="640"
            Margin="48,12,48,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Shadow="{StaticResource DialogShadow}"
            Translation="0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{ThemeResource NavigationViewContentBackground}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="16,16,4,16"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Select a model to use for this sample" />
                    <Button
                        x:Name="HelpMeChooseButton"
                        Width="24"
                        Height="24"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        AutomationProperties.Name="What's the difference between these?"
                        ToolTipService.ToolTip="What's the difference between these?">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE897;" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="600" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Width="540" Spacing="16">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Two ways to add AI to your app" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                                            <StackPanel Spacing="8">
                                                <FontIcon
                                                    HorizontalAlignment="Left"
                                                    FontSize="24"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE81E;" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Windows AI APIs" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Use AI that's already built into Windows"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="Call ready-made features with no model to download or manage — the fastest way to add AI for common tasks. Requires a Copilot+ PC."
                                                    TextWrapping="Wrap" />
                                                <HyperlinkButton
                                                    Margin="0,4,0,0"
                                                    Content="Learn more"
                                                    NavigateUri="https://learn.microsoft.com/windows/ai/apis/" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Padding="16"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                                            <StackPanel Spacing="8">
                                                <FontIcon
                                                    HorizontalAlignment="Left"
                                                    FontSize="24"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xF158;" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom models" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Download and run your own model"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="Pick from hundreds of models, download one, and run it locally with full control — plus export-ready code. Works on many PCs."
                                                    TextWrapping="Wrap" />
                                                <HyperlinkButton
                                                    Margin="0,4,0,0"
                                                    Content="Learn more"
                                                    NavigateUri="https://learn.microsoft.com/windows/ai/overview" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <InfoBar
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="Not sure? Start with Windows AI APIs — you can switch to a custom model anytime."
                                        Severity="Informational" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="CancelButton"
                    Margin="12"
                    Padding="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Close"
                    Click="OnCancel_Clicked"
                    Content="{ui:FontIcon Glyph=&#xE894;,
                                          FontSize=16}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Close" />
            </Grid>
            <ListView
                x:Name="modelTypeSelector"
                Grid.Row="1"
                Width="186"
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                SelectionChanged="ModelTypeSelector_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="modelpickerviews:ModelPickerDefinition">
                        <Grid ColumnSpacing="16"
                            AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{x:Bind Icon, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid
                x:Name="modelsGrid"
                Grid.Row="1"
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0" />
            <Grid
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Padding="16"
                Background="{ThemeResource CardGradient2Brush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8"
                RowSpacing="8"
                Translation="0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Models selected for this sample" />
                <ItemsRepeater
                    x:Name="SelectedModelsRepeater"
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind modelSelectionItems}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelSelectionItem">
                            <Border
                                DataContext="{x:Bind}"
                                MinWidth="248"
                                MinHeight="48"
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                IsTabStop="True"
                                UseSystemFocusVisuals="True"
                                KeyDown="SelectedModelItem_KeyDown"
                                Tapped="SelectedModelItem_Tapped"
                                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                AutomationProperties.HelpText="Press Enter or Space to select model.">
                                <Grid>
                                    <Grid
                                        Padding="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind utils:XamlHelpers.VisibleWhenNull(SelectedModel), Mode=OneWay}">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No model selected.." />
                                    </Grid>
                                    <Grid RowSpacing="4" Visibility="{x:Bind utils:XamlHelpers.VisibleWhenNotNull(SelectedModel), Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Width="20"
                                            HorizontalAlignment="Left"
                                            Source="{x:Bind SelectedModel.Icon, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind SelectedModel.Name, Mode=OneWay}" />
                                        <ItemsRepeater
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ItemsSource="{x:Bind SelectedModel.HardwareAccelerators, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:HardwareAccelerator">
                                                    <Button
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind utils:AppUtils.GetHardwareAcceleratorMoreInfoName((models:HardwareAccelerator))}"
                                                        Content="{x:Bind utils:AppUtils.GetHardwareAcceleratorString((models:HardwareAccelerator))}"
                                                        Style="{StaticResource TertiaryButtonStyle}"
                                                        ToolTipService.ToolTip="More info"
                                                        Background="{ThemeResource ButtonBackground}">
                                                        <Button.Flyout>
                                                            <Flyout ShouldConstrainToRootBounds="False">
                                                                <TextBlock
                                                                    MaxWidth="360"
                                                                    Text="{x:Bind utils:AppUtils.GetHardwareAcceleratorDescription((models:HardwareAccelerator))}"
                                                                    TextWrapping="Wrap" />
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button
                    x:Name="SaveButton"
                    Grid.Row="1"
                    Width="120"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="Run sample"
                    Click="OnSave_Clicked"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Vertical" Spacing="4">
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                        <TextBlock Text="Run sample" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SidePaneVisibilityStates">
                <VisualState x:Name="SidePaneVisible" />
                <VisualState x:Name="SidePaneCollapsed">
                    <VisualState.Setters>
                        <Setter Target="modelTypeSelector.Visibility" Value="Collapsed" />
                        <Setter Target="modelsGrid.BorderThickness" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
