<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AIDevGallery.Controls.HeaderCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AIDevGallery.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <RadialGradientBrush x:Key="OverlayRadialGradient" Center="0.5,0.22" GradientOrigin="0.5,0" MappingMode="RelativeToBoundingBox" RadiusX="0.92" RadiusY="0.8200000000000001" SpreadMethod="Pad">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.05" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.35" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.55" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.95" Color="#00FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </RadialGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <RadialGradientBrush x:Key="OverlayRadialGradient" Center="0.5,0.22" GradientOrigin="0.5,0.0" MappingMode="RelativeToBoundingBox" RadiusX="0.92" RadiusY="0.8200000000000001" SpreadMethod="Pad">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.05" Color="#FF000000" />
                        <GradientStop Offset="0.35" Color="#FF000000" />
                        <GradientStop Offset="0.55" Color="#FF000000" />
                        <GradientStop Offset="0.85" Color="#00000000" />
                        <GradientStop Offset="0.95" Color="#00000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <RadialGradientBrush x:Key="OverlayRadialGradient" Center="0.5,0.22" GradientOrigin="0.5,0" MappingMode="RelativeToBoundingBox" RadiusX="0.92" RadiusY="0.8200000000000001" SpreadMethod="Pad">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="0.05" Color="#FF000000" />
                        <GradientStop Offset="0.35" Color="#FF000000" />
                        <GradientStop Offset="0.55" Color="#FF000000" />
                        <GradientStop Offset="0.95" Color="#00000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <LinearGradientBrush x:Key="LightTextGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.1" Color="#FFFFFF" />
                <GradientStop Offset="0.3" Color="#E9E9E9" />
                <GradientStop Offset="0.6" Color="#FDFDFD" />
                <GradientStop Offset="0.9" Color="#FFFFFF" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DarkTextGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.1" Color="#303030" />
                <GradientStop Offset="0.3" Color="#4A4A4A" />
                <GradientStop Offset="0.6" Color="#161515" />
                <GradientStop Offset="0.9" Color="#303030" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" CornerRadius="8,0,0,0" MinHeight="440">
        <Grid.Background>
            <!-- ponytail: single light gradient per design ref; dark theme keeps this same light hero -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#B8ADE0" />
                <GradientStop Offset="0.2475" Color="#D1BFE5" />
                <GradientStop Offset="0.4596" Color="#EDD1C7" />
                <GradientStop Offset="0.7071" Color="#F5E8D9" />
            </LinearGradientBrush>
        </Grid.Background>
        <!-- Vertical fade: gradient stays vivid up top, fades into the page background toward the bottom -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00F9F9F9" />
                    <GradientStop Offset="0.55" Color="#00F9F9F9" />
                    <GradientStop Offset="1" Color="#FFF9F9F9" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid
            MaxWidth="1080"
            HorizontalAlignment="Center"
            Padding="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <!-- Transparent floating object: fit whole, no card clip -->
        <Image Grid.Column="1"
               Margin="48,24,0,24"
               MaxHeight="360"
               Source="ms-appx:///Assets/HomeHero.png"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
        <StackPanel Grid.Column="0"
                    MaxWidth="400"
                    Padding="0,12,24,24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Spacing="12">
            <TextBlock HorizontalAlignment="Left"
                       CharacterSpacing="0"
                       FontSize="40"
                       FontWeight="Bold"
                       Opacity="0.8"
                       Text="Build your first Windows AI feature"
                       TextAlignment="Left"
                       TextWrapping="Wrap">
                <TextBlock.Foreground>
                    <LinearGradientBrush x:Name="AnimatedGradientBrush"
                                         StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Offset="0.1"
                                      Color="#303030" />
                        <GradientStop Offset="0.3"
                                      Color="#4A4A4A" />
                        <GradientStop Offset="0.6"
                                      Color="#161515" />
                        <GradientStop Offset="0.9"
                                      Color="#303030" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                       RequestedTheme="Light"
                       HorizontalAlignment="Left"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Left"
                       TextWrapping="Wrap">
                <Run Text="Choose what you want to add your app. We'll recommend a sample, model, hardware path, and export-ready starter code." />
                <Run Text="This app is in" />
                <Hyperlink NavigateUri="https://aka.ms/ai-dev-gallery" TabIndex="0">preview</Hyperlink><Run Text="." />
            </TextBlock>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
