<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AIDevGallery.Controls.GettingStartedSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AIDevGallery.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="GoalCardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="GoalCardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" />
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1.03"
                                                Duration="0:0:0.15" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1.03"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.98"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.98"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaceholderImageStyle" TargetType="Border">
            <Setter Property="Height" Value="160" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="TagPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2,8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid
        x:Name="ContentGrid"
        Margin="24,0,24,24"
        RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="What are you trying to build?" />

        <Grid
            Grid.Row="1"
            ColumnSpacing="24"
            RowSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Add local chat -->
            <Button
                Style="{StaticResource GoalCardButtonStyle}"
                Tag="chat"
                Click="Card_Click"
                AutomationProperties.Name="Add local chat to my app">
                <Grid Style="{StaticResource GoalCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PlaceholderImageStyle}">
                    <Image Source="ms-appx:///Assets/TileImages/Chat.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Row="1"
                    Padding="16"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Add local chat to my app"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Build a private chat experience with a local model."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Text" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Runs locally" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Exportable" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Button>

            <!-- Summarize documents -->
            <Button
                Grid.Column="1"
                Style="{StaticResource GoalCardButtonStyle}"
                Tag="summarize-text"
                Click="Card_Click"
                AutomationProperties.Name="Summarize documents offline">
                <Grid Style="{StaticResource GoalCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PlaceholderImageStyle}">
                    <Image Source="ms-appx:///Assets/TileImages/TextSummarization.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Row="1"
                    Padding="16"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Summarize documents offline"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Extract key points without sending content to the cloud."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Text" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Privacy" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="C#" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Button>

            <!-- Analyze images -->
            <Button
                Grid.Column="2"
                Style="{StaticResource GoalCardButtonStyle}"
                Tag="describe-image"
                Click="Card_Click"
                AutomationProperties.Name="Analyze images">
                <Grid Style="{StaticResource GoalCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PlaceholderImageStyle}">
                    <Image Source="ms-appx:///Assets/TileImages/ClassifyImage.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Row="1"
                    Padding="16"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Analyze images"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Identify objects, read UI screenshots, or classify photos."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Vision" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="NPU ready" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Image" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Button>

            <!-- Transcribe audio -->
            <Button
                Grid.Row="1"
                Style="{StaticResource GoalCardButtonStyle}"
                Tag="transcribe-audio"
                Click="Card_Click"
                AutomationProperties.Name="Transcribe audio">
                <Grid Style="{StaticResource GoalCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PlaceholderImageStyle}">
                    <Image Source="ms-appx:///Assets/TileImages/Transcription.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Row="1"
                    Padding="16"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Transcribe audio"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Turn speech into text for notes, captions, or search."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Audio" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Runs locally" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Button>

            <!-- Generate app content -->
            <Button
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource GoalCardButtonStyle}"
                Tag="generate-text"
                Click="Card_Click"
                AutomationProperties.Name="Generate app content">
                <Grid Style="{StaticResource GoalCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PlaceholderImageStyle}">
                    <Image Source="ms-appx:///Assets/TileImages/TextGeneration.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Row="1"
                    Padding="16"
                    Spacing="8">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Generate app content"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Create titles, descriptions, or suggestions in your UI."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Text" />
                        </Border>
                        <Border Style="{StaticResource TagPillStyle}">
                            <TextBlock Style="{StaticResource TagTextStyle}" Text="Creative" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Button>

            <!-- Browse all samples -->
            <Button
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource GoalCardButtonStyle}"
                Tag="Samples"
                Click="Card_Click"
                AutomationProperties.Name="Browse all samples">
                <Grid Style="{StaticResource GoalCardStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PlaceholderImageStyle}">
                        <Image Source="ms-appx:///Assets/TileImages/SemanticSearch.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Padding="16"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Browse all samples"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Already know what you need? Go to the full gallery."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="Explore samples" />
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE76C;" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
